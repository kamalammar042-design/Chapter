# ------------------------------------------------------------
# Chapter — front-end configuration (Vite reads VITE_* at build time)
# Copy to .env.local for development. Set the same variables in your
# hosting provider (Netlify: Site settings → Environment variables),
# with different values per context: development, deploy previews and
# production should each use their own Supabase project.
# ------------------------------------------------------------

# Supabase project URL and anon (public) key: Dashboard → Project Settings → API.
# The anon key is designed to be public; Row Level Security protects data.
# NEVER put the service_role key in any VITE_ variable (the app refuses to start with one).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# development | preview | production (Netlify sets this per context; see netlify.toml).
# Preview builds show a "Preview environment" banner.
VITE_APP_ENV=development


# Chapter Plus (optional): RevenueCat Web Billing public API key. Plus is shown only when set.
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_ENTITLEMENT=plus

# AI provider the Edge Functions use (anthropic | groq | openrouter), named in the
# privacy policy. Must match the AI_PROVIDER / key set in the function secrets; leave
# empty while AI is off.
VITE_AI_PROVIDER=

# Review reminders (optional): OneSignal Web app id (public). The Settings card appears only when set.
VITE_ONESIGNAL_APP_ID=

# Optional: shown in error reports so they can be matched to a release.
VITE_APP_VERSION=2.0.0

# ------------------------------------------------------------
# Edge Function secrets are NOT set here. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# See supabase/functions/.env.example.
# ------------------------------------------------------------
