{
  "name": "chapter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run content:check && npm run test && npm run test:db && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "resources:import": "node scripts/import-past-papers.mjs",
    "content:build": "tsx scripts/generate-content-sql.ts",
    "content:check": "tsx scripts/generate-content-sql.ts --check",
    "links:check": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.80.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.3.0",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.29.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
