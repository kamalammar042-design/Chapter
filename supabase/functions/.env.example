# Edge Function secrets. Set with: supabase secrets set --env-file supabase/functions/.env
# Use a separate Supabase project (and separate keys) for development, preview and production.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# Never commit the filled-in file (it is in .gitignore).

# --- AI (required for the tutor, scanning and generation) ---
# Set ONE provider key. With several, AI_PROVIDER picks (anthropic | groq | openrouter);
# otherwise the first set in this order is used. See docs/AI.md.
# Also set VITE_AI_PROVIDER on the web host to the same value: the privacy policy names it.
ANTHROPIC_API_KEY=
# Groq: free tier, open models (gpt-oss, Qwen), no training on your data. console.groq.com
GROQ_API_KEY=
# Optional on a paid Groq plan: per-request token budget (free tier default 7500)
# GROQ_TOKEN_BUDGET=7500
# OpenRouter: Claude models billed to OpenRouter credit (Shipaton Ship Kit gives $10). openrouter.ai
OPENROUTER_API_KEY=
# AI_PROVIDER=groq

# Model routing (all optional; Anthropic defaults shown; Groq and OpenRouter
# have their own defaults in docs/AI.md). Model names must suit the provider.
# chat, explain, hint, simplify, practice
# MODEL_TUTOR=claude-sonnet-5
# check my work, explain my mistake, study plan, scan
# MODEL_TUTOR_DEEP=claude-opus-5
# writing new questions
# MODEL_GENERATE=claude-sonnet-5
# independently solving generated questions
# MODEL_VERIFY=claude-opus-5
# memory notes, flashcards
# MODEL_LIGHT=claude-haiku-4-5
# Optional effort per group: low | medium | high (ignored by models without effort support)
# MODEL_TUTOR_EFFORT=medium
# MODEL_TUTOR_DEEP_EFFORT=medium
# MODEL_VERIFY_EFFORT=low
# Older name, still honoured for MODEL_TUTOR: TUTOR_MODEL / TUTOR_EFFORT

# --- CORS: comma-separated origins allowed to call the functions ---
ALLOWED_ORIGINS=https://your-domain.example,http://localhost:5173

# --- Scheduled jobs: shared secret for the link checker (24+ random characters) ---
CRON_SECRET=

# --- Chapter Plus (RevenueCat); see docs/REVENUECAT_SETUP.md ---
# Authorization header secret for the webhook (24+ random characters)
REVENUECAT_WEBHOOK_AUTH=
# Secret API key (API version 1) used by revenuecat-sync
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT_ID=plus
